#include <stdio.h>
int main()
{
int day, month, year;
int total, leap, i;
int days[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
printf("Enter date (DD MM YYYY): ");
scanf("%d %d %d", &day, &month, &year);
leap = 0;
if ((year % 400 == 0) ||
(year % 4 == 0 && year % 100 != 0)) {
leap = 1;
days[2] = 29;}
if (month < 1 || month > 12 ||
day < 1 || day > days[month]){
printf("Invalid Date");
return 0;}
total = day;
for (i = 1; i < month; i++){
total = total + days[i];}
total = total + (year - 1) * 365;
total = total + (year - 1) / 4;
total = total - (year - 1) / 100;
total = total + (year - 1) / 400;
switch (total % 7)
{ case 0:
printf("Sunday");
break;
case 1:
printf("Monday");
break;
case 2:
printf("Tuesday");
break;
case 3:
printf("Wednesday");
break;
case 4:
printf("Thursday");
break;
case 5:
printf("Friday");
break;
case 6:
printf("Saturday");
break;}
return 0;}